# Python
__pycache__/
*.pyc
*.pyo

# Model checkpoints
checkpoints/*
!checkpoints/*/.gitkeep
checkpoints_*/

# HF 转换产物 (tools/convert_megatron_to_hf.py 生成，不入库)
hf/checkpoints/

# Weights & Biases (local run dirs, never commit)
wandb/

# Training data — 根 data/ 整目录忽略（仅 .gitkeep 级反忽略有效；已排除的父目录
# 下子目录无法用 ! 重新包含，需入库的小文件请用 git add -f 显式添加）
data/
!data/.gitkeep
!data/raw/.gitkeep
# gleamlm/data/ 是核心库数据层（dataset/pack/pipeline/preprocess），
# 上面的 data/ 模式会递归匹配任意层级的同名目录，必须显式反忽略
!gleamlm/data/

# Tokenizer checkpoints (keep 12K, ignore test)

# Build artifacts
build/
dist/
gleamlm.egg-info/

# Documentation
docs/

# Architecture Decision Records（本地决策档案，随设计文档体系不入库）
adr/

# TensorBoard logs
**/runs/

# Images (training curves)
images/
# WebUI 背景图需入库（webui/logs/ 已被 logs/、*.log 覆盖忽略）
!webui/images/
!webui/images/*

# IDE
.vscode/
.idea/
.DS_Store

# IDE config
opencode.json
.claude/
AGENTS.md

# WorkBuddy agent 工作目录（会话记忆/项目数据，非源码，不入库）
.workbuddy/

# 本地 skill（复用旧仓库，不入库）
.opencode/skills/

# Qoder 项目级 skill（不入库）
.qoder/skills/

# Local issue tracker (internal planning)
.scratch/

# Lint & type-check caches
.ruff_cache/
.mypy_cache/

# Pytest cache
.pytest_cache/

# Temporary files
*.log
temp_*
infer_result.txt

# Local experiment output dirs
logs/
eval_results/

# 用户自定义配置副本（面板「另存为我的配置」的目标目录，个人实验不入库）
my_configs/

# Stale test data patterns
data/test_splits/
data/splits/*.npy
*.backup